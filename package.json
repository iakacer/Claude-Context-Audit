{
  "name": "claude-context-audit",
  "displayName": "Context Audit for Claude Code",
  "description": "See every MCP server, plugin, skill, agent and hook Claude Code loads in this project, what each costs in tokens, and switch off what you never use.",
  "version": "0.2.1",
  "publisher": "YangLiu0802",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --out claude-context-audit.vsix"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeInventory",
          "title": "Context Audit",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeInventory": [
        {
          "id": "claudeInventory.view",
          "name": "Loaded context"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeInventory.refresh",
        "title": "Refresh",
        "category": "Context Audit",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeInventory.disableMcp",
        "title": "Disable MCP Server",
        "category": "Context Audit",
        "icon": "$(circle-slash)"
      },
      {
        "command": "claudeInventory.enableMcp",
        "title": "Enable MCP Server",
        "category": "Context Audit",
        "icon": "$(check)"
      },
      {
        "command": "claudeInventory.disablePlugin",
        "title": "Disable Plugin",
        "category": "Context Audit",
        "icon": "$(circle-slash)"
      },
      {
        "command": "claudeInventory.enablePlugin",
        "title": "Enable Plugin",
        "category": "Context Audit",
        "icon": "$(check)"
      },
      {
        "command": "claudeInventory.resetPlugin",
        "title": "Reset Plugin Override (Use Inherited)",
        "category": "Context Audit",
        "icon": "$(discard)"
      },
      {
        "command": "claudeInventory.openSource",
        "title": "Open Source File",
        "category": "Context Audit"
      },
      {
        "command": "claudeInventory.openLatestTranscript",
        "title": "Open Latest Transcript",
        "category": "Context Audit",
        "icon": "$(history)"
      },
      {
        "command": "claudeInventory.disableMcpGlobal",
        "title": "Disable in All Projects",
        "category": "Context Audit",
        "icon": "$(circle-slash)"
      },
      {
        "command": "claudeInventory.enableMcpGlobal",
        "title": "Enable in All Projects",
        "category": "Context Audit",
        "icon": "$(check)"
      },
      {
        "command": "claudeInventory.disablePluginGlobal",
        "title": "Disable in All Projects",
        "category": "Context Audit",
        "icon": "$(circle-slash)"
      },
      {
        "command": "claudeInventory.enablePluginGlobal",
        "title": "Enable in All Projects",
        "category": "Context Audit",
        "icon": "$(check)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeInventory.refresh",
          "when": "view == claudeInventory.view",
          "group": "navigation@1"
        },
        {
          "command": "claudeInventory.openLatestTranscript",
          "when": "view == claudeInventory.view",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeInventory.disableMcp",
          "when": "view == claudeInventory.view && viewItem =~ /^mcp:on/",
          "group": "inline@1"
        },
        {
          "command": "claudeInventory.enableMcp",
          "when": "view == claudeInventory.view && viewItem =~ /^mcp:off/",
          "group": "inline@1"
        },
        {
          "command": "claudeInventory.disablePlugin",
          "when": "view == claudeInventory.view && viewItem =~ /^plugin:on/",
          "group": "inline@1"
        },
        {
          "command": "claudeInventory.enablePlugin",
          "when": "view == claudeInventory.view && viewItem =~ /^plugin:off/",
          "group": "inline@1"
        },
        {
          "command": "claudeInventory.resetPlugin",
          "when": "view == claudeInventory.view && viewItem =~ /^plugin:(on|off):local/",
          "group": "inline@2"
        },
        {
          "command": "claudeInventory.openSource",
          "when": "view == claudeInventory.view && viewItem =~ /:source$/",
          "group": "navigation@1"
        },
        {
          "command": "claudeInventory.disableMcp",
          "when": "view == claudeInventory.view && viewItem =~ /^mcp:on/",
          "group": "toggle@1"
        },
        {
          "command": "claudeInventory.enableMcp",
          "when": "view == claudeInventory.view && viewItem =~ /^mcp:off/",
          "group": "toggle@1"
        },
        {
          "command": "claudeInventory.disablePlugin",
          "when": "view == claudeInventory.view && viewItem =~ /^plugin:on/",
          "group": "toggle@1"
        },
        {
          "command": "claudeInventory.enablePlugin",
          "when": "view == claudeInventory.view && viewItem =~ /^plugin:off/",
          "group": "toggle@1"
        },
        {
          "command": "claudeInventory.resetPlugin",
          "when": "view == claudeInventory.view && viewItem =~ /^plugin:(on|off):local/",
          "group": "toggle@2"
        },
        {
          "command": "claudeInventory.disableMcpGlobal",
          "when": "view == claudeInventory.view && viewItem =~ /^mcp:on:user/",
          "group": "global@1"
        },
        {
          "command": "claudeInventory.enableMcpGlobal",
          "when": "view == claudeInventory.view && viewItem =~ /^mcp:stashed/",
          "group": "inline@1"
        },
        {
          "command": "claudeInventory.enableMcpGlobal",
          "when": "view == claudeInventory.view && viewItem =~ /^mcp:stashed/",
          "group": "global@1"
        },
        {
          "command": "claudeInventory.disablePluginGlobal",
          "when": "view == claudeInventory.view && viewItem =~ /^plugin:on/",
          "group": "global@1"
        },
        {
          "command": "claudeInventory.enablePluginGlobal",
          "when": "view == claudeInventory.view && viewItem =~ /^plugin:off/",
          "group": "global@1"
        }
      ]
    },
    "configuration": {
      "title": "Context Audit for Claude Code",
      "properties": {
        "claudeInventory.usageWindowDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Number of days of Claude Code sessions to scan for usage."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.26.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "icon": "media/icon.png",
  "license": "MIT",
  "author": {
    "name": "Yang Liu"
  },
  "keywords": [
    "claude",
    "claude code",
    "mcp",
    "tokens",
    "context",
    "plugins",
    "skills",
    "audit"
  ],
  "galleryBanner": {
    "color": "#1B1A18",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iakacer/Claude-Context-Audit.git"
  },
  "bugs": {
    "url": "https://github.com/iakacer/Claude-Context-Audit/issues"
  },
  "homepage": "https://github.com/iakacer/Claude-Context-Audit#readme"
}
